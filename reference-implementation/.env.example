# Copy to .env (or export) before running `pumfai ask`, `pumfai eval` or POST /ask
ANTHROPIC_API_KEY=sk-ant-...
# Model for intent, variable selection and narration (default claude-haiku-5-5)
PUMFAI_MODEL=claude-haiku-5-5
# Optional stronger model for the query planner only
# PUMFAI_PLANNER_MODEL=claude-sonnet-5-5
# PUMFAI_DATA_DIR=./data
# PUMFAI_RELEASE=cius_synth_2022
# PUMFAI_LOG_DIR=./logs
